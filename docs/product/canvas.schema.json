{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/forsvn-labs/horsemen/main/docs/product/canvas.schema.json",
  "title": "Horsemen canvas, profile version 1",
  "description": "A JSON Canvas 1.0 file (https://jsoncanvas.org/spec/1.0/) with limits and three optional keys: top-level `horsemen`, `alt` on file nodes, and `title` on link nodes. Unknown keys and unknown node types are allowed and must be kept on save. Proposal; see docs/product/canvas-workspace.md.",
  "type": "object",
  "properties": {
    "horsemen": {
      "type": "object",
      "properties": { "version": { "type": "integer", "minimum": 1 } },
      "required": ["version"]
    },
    "nodes": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/edge" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
    "color": { "type": "string", "pattern": "^(?:[1-6]|#[0-9A-Fa-f]{6})$" },
    "coordinate": { "type": "integer", "minimum": -1000000, "maximum": 1000000 },
    "size": { "type": "integer", "minimum": 16, "maximum": 8192 },
    "side": { "enum": ["top", "right", "bottom", "left"] },
    "end": { "enum": ["none", "arrow"] },
    "path": {
      "description": "A file path relative to the project root. No leading slash, no `.` or `..` segment, no backslash, no control character.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!(?:[\\s\\S]*/)?\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f]+$"
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "x", "y", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "minLength": 1, "maxLength": 32 },
        "x": { "$ref": "#/$defs/coordinate" },
        "y": { "$ref": "#/$defs/coordinate" },
        "width": { "$ref": "#/$defs/size" },
        "height": { "$ref": "#/$defs/size" },
        "color": { "$ref": "#/$defs/color" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": {
            "required": ["text"],
            "properties": { "text": { "type": "string", "maxLength": 20000 } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "file" } } },
          "then": {
            "required": ["file"],
            "properties": {
              "file": { "$ref": "#/$defs/path" },
              "subpath": { "type": "string", "pattern": "^#[^\\u0000-\\u001f]{1,300}$" },
              "alt": { "type": "string", "maxLength": 500 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "link" } } },
          "then": {
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "maxLength": 2048, "pattern": "^https?://[^\\s\\u0000-\\u001f]+$" },
              "title": { "type": "string", "maxLength": 200 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "group" } } },
          "then": {
            "properties": {
              "label": { "type": "string", "maxLength": 200 },
              "background": { "$ref": "#/$defs/path" },
              "backgroundStyle": { "enum": ["cover", "ratio", "repeat"] }
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": ["id", "fromNode", "toNode"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "fromNode": { "$ref": "#/$defs/id" },
        "toNode": { "$ref": "#/$defs/id" },
        "fromSide": { "$ref": "#/$defs/side" },
        "toSide": { "$ref": "#/$defs/side" },
        "fromEnd": { "$ref": "#/$defs/end" },
        "toEnd": { "$ref": "#/$defs/end" },
        "color": { "$ref": "#/$defs/color" },
        "label": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
